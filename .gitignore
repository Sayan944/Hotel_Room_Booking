# ==========================================
# Hotel Room Booking System - Root .gitignore
# ==========================================

# Ignore Node.js dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Ignore log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore IDE settings
.vscode/
.idea/

# Ignore OS files
.DS_Store
Thumbs.db
desktop.ini

# Ignore temporary files
*.tmp
*.temp